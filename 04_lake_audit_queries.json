[
  {
    "description": "Total Document Count Landing Check",
    "query": [
      { "$count": "total_landed_documents" }
    ]
  },
  {
    "description": "Breakdown of Landed Payloads by Stream Source",
    "query": [
      {
        "$group": {
          "_id": "$stream_source",
          "doc_count": { "$sum": 1 }
        }
      },
      { "$sort": { "doc_count": -1 } }
    ]
  },
  {
    "description": "Identify Payloads Missing Essential Checkout Attributes",
    "query": [
      {
        "$match": {
          "event_data.checkout_id": { "$exists": false }
        }
      }
    ]
  }
]